APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Base dédiée aux tables techniques Laravel (migrations, users, cache, jobs, sessions)
DB_LARAVEL_HOST=127.0.0.1
DB_LARAVEL_PORT=3306
DB_LARAVEL_DATABASE=laravel
DB_LARAVEL_USERNAME=root
DB_LARAVEL_PASSWORD=

SESSION_DRIVER=database
SESSION_CONNECTION=mysql_laravel
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=mysql_laravel
DB_QUEUE_BATCHING_CONNECTION=mysql_laravel
DB_QUEUE_FAILED_CONNECTION=mysql_laravel

CACHE_STORE=database
DB_CACHE_CONNECTION=mysql_laravel
DB_CACHE_LOCK_CONNECTION=mysql_laravel
# Les migrations Laravel (users, cache, jobs, sessions) sont nécessaires si SESSION_DRIVER=database,
# CACHE_STORE=database et QUEUE_CONNECTION=database. Ne les supprimez pas sans passer ces options en file/sync.
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@willwvs.pro"
MAIL_FROM_NAME="BéninFreelance"

RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Gemini (Google AI Studio) — ne jamais committer la vraie cle
GEMINI_API_KEY=

# Mot de passe admin (panel /admin), separe du reste de l'app
ADMIN_PASSWORD=
# E-mail recevant les alertes (avis signalés, etc.)
ADMIN_EMAIL=

# FedaPay — dashboard https://sandbox.fedapay.com (sandbox) ou https://live.fedapay.com (live)
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
FEDAPAY_WEBHOOK_SECRET_PAYOUT=
FEDAPAY_CURRENCY=XOF
FEDAPAY_COUNTRY=bj

# Commandes marketplace
APP_COMMISSION_RATE=0
APP_SUBSCRIPTION_DAYS=30
APP_AUTO_RELEASE_DAYS=14
APP_ACCEPT_DEADLINE_HOURS=48
